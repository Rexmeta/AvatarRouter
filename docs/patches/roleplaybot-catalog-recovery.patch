diff --git a/client/src/components/admin/PersonaVoiceSettings.tsx b/client/src/components/admin/PersonaVoiceSettings.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c46d640afeb7ff9a584f291de4cf09e35b1824f7
--- /dev/null
+++ b/client/src/components/admin/PersonaVoiceSettings.tsx
@@ -0,0 +1,144 @@
+import { useEffect, useState } from 'react';
+import { Button } from '@/components/ui/button';
+import { apiRequest } from '@/lib/queryClient';
+import { personaVoiceCatalogResponseSchema, type PersonaLiveAvatar, type PersonaVoice } from '@shared/avatar/personaAvatar';
+
+type VoiceSelection = NonNullable<PersonaLiveAvatar['voiceSelection']>;
+type Gender = VoiceSelection['gender'];
+type Catalog = ReturnType<typeof personaVoiceCatalogResponseSchema.parse>['voiceCatalog'];
+type LoadState =
+  | { status: 'loading' }
+  | { status: 'error'; message: string }
+  | { status: 'ready'; catalog: Catalog };
+
+function voiceError(error: unknown): string {
+  const message = error instanceof Error ? error.message : '';
+  if (/^403:/.test(message)) return '음성 목록 조회 권한이 없습니다. 프로젝트 API 키의 assets:read 권한을 확인하세요.';
+  if (/^404:/.test(message)) return '현재 AvatarRouter에서 음성 목록을 제공하지 않습니다. 라우터 버전을 확인하세요.';
+  if (/^503:|persona_voice_catalog_unavailable/.test(message)) return 'AvatarRouter 음성 목록이 일시적으로 중단되었습니다.';
+  return '음성 목록을 불러오지 못했습니다. 연결 상태를 확인하세요.';
+}
+
+export function PersonaVoiceSettings({ projectId, avatar, disabled, onChange }: {
+  projectId: string | null;
+  avatar: PersonaLiveAvatar;
+  disabled: boolean;
+  onChange(avatar: PersonaLiveAvatar): void;
+}) {
+  const selected = avatar.voiceSelection;
+  const [gender, setGender] = useState<Gender>(selected?.gender ?? 'male');
+  const [state, setState] = useState<LoadState>({ status: 'loading' });
+  const [attempt, setAttempt] = useState(0);
+  const retry = () => {
+    setState({ status: 'loading' });
+    setAttempt(count => count + 1);
+  };
+
+  useEffect(() => { setGender(selected?.gender ?? 'male'); }, [selected?.gender]);
+  useEffect(() => {
+    if (!projectId) return;
+    let active = true;
+    void (async () => {
+      try {
+        const response = await apiRequest('GET', '/api/admin/personas/live-avatar/voices');
+        const result = personaVoiceCatalogResponseSchema.parse(await response.json());
+        if (!active) return;
+        if (result.projectId !== projectId) {
+          setState({ status: 'error', message: '연결된 프로젝트가 변경되었습니다. 아바타 목록을 먼저 새로고침하세요.' });
+          return;
+        }
+        setState({ status: 'ready', catalog: result.voiceCatalog });
+      } catch (cause) {
+        if (active) setState({ status: 'error', message: voiceError(cause) });
+      }
+    })();
+    return () => { active = false; };
+  }, [projectId, attempt]);
+
+  const catalog = state.status === 'ready' ? state.catalog : undefined;
+  const provider = catalog?.providers.find(item => item.providerId === avatar.providerId);
+  const verified = provider?.status === 'available';
+  const selectedEntry = verified && selected && catalog?.voices.find(voice =>
+    voice.providerId === avatar.providerId && voice.id === selected.voiceId &&
+    voice.gender === selected.gender && voice.available);
+  const options = verified ? catalog?.voices.filter(voice =>
+    voice.providerId === avatar.providerId && voice.gender === gender && voice.available) ?? [] : [];
+  const includeSelected = selected && !options.some(voice => voice.id === selected.voiceId && voice.gender === selected.gender);
+  const selectedValue = includeSelected ? `saved/${selected.voiceId}` : selected?.voiceId ?? '';
+  const optionLabel = (voice: PersonaVoice) => `${voice.name}${voice.genderSource === 'admin' ? ' · 관리자 분류' : ''}`;
+
+  function chooseVoice(id: string) {
+    if (!verified || disabled) return;
+    if (!id) {
+      const { voiceSelection: _removed, ...withoutVoice } = avatar;
+      onChange(withoutVoice);
+      return;
+    }
+    const voice = options.find(item => item.id === id);
+    if (voice && voice.gender !== 'unclassified') {
+      onChange({ ...avatar, voiceSelection: { voiceId: voice.id, gender: voice.gender } });
+    }
+  }
+
+  return (
+    <section className="space-y-3 rounded-md border border-indigo-200 bg-indigo-50/50 p-4" aria-label="라이브 대화 음성 모델">
+      <div>
+        <h4 className="text-sm font-semibold text-slate-800">라이브 대화 음성</h4>
+        <p className="mt-1 text-xs leading-relaxed text-slate-600">
+          선택한 Tavus·Anam 전체 파이프라인이 대화와 음성을 생성합니다. 이 모드에서는 Gemini Live 음성을 함께 실행하지 않습니다.
+        </p>
+      </div>
+      {!projectId ? <p className="text-xs text-slate-600">음성 목록은 아바타 목록 조회 후 표시됩니다.</p>
+        : state.status === 'loading' ? <p role="status" className="text-xs text-slate-600">음성 목록을 불러오는 중입니다.</p>
+        : state.status === 'error' || !verified ? (
+          <div role="alert" className="text-xs text-amber-900">
+            <p>{state.status === 'error' ? state.message
+              : provider?.status === 'unconfigured' ? '이 제공자의 음성 목록이 설정되지 않았습니다.'
+              : '이 제공자의 음성 목록을 현재 확인할 수 없습니다.'} 아바타 목록은 계속 사용할 수 있습니다.</p>
+            <Button type="button" variant="link" className="h-auto p-0 text-amber-900" disabled={disabled} onClick={retry}>
+              음성 목록 다시 시도
+            </Button>
+          </div>
+        ) : (
+          <>
+            <div className="grid gap-3 sm:grid-cols-2">
+              <label className="text-xs font-medium text-slate-700">
+                음성 성별
+                <select aria-label="음성 성별" value={gender} disabled={disabled}
+                  onChange={event => setGender(event.target.value as Gender)}
+                  className="mt-1 h-10 w-full rounded-md border border-slate-300 bg-white px-3 text-sm">
+                  <option value="male">남성</option>
+                  <option value="female">여성</option>
+                  <option value="neutral">중립</option>
+                </select>
+              </label>
+              <label className="text-xs font-medium text-slate-700">
+                음성 모델
+                <select aria-label="음성 모델" value={selectedValue} disabled={disabled}
+                  onChange={event => chooseVoice(event.target.value)}
+                  className="mt-1 h-10 w-full rounded-md border border-slate-300 bg-white px-3 text-sm">
+                  <option value="">공급자 기본 음성 사용</option>
+                  {includeSelected && (
+                    <option disabled value={selectedValue}>
+                      {selectedEntry ? optionLabel(selectedEntry) : `저장된 음성 · ${selected.voiceId} (확인 필요)`}
+                    </option>
+                  )}
+                  {options.map(voice => <option key={voice.id} value={voice.id}>{optionLabel(voice)}</option>)}
+                </select>
+              </label>
+            </div>
+            {!options.length && <p className="text-xs text-slate-600">이 성별로 분류되어 선택 가능한 음성이 없습니다.</p>}
+            <Button type="button" variant="link" className="h-auto p-0" disabled={disabled} onClick={retry}>
+              음성 목록 새로고침
+            </Button>
+          </>
+        )}
+      {selected && !selectedEntry && (
+        <p className="break-all text-xs text-amber-900" role="status">
+          저장된 음성 · {selected.voiceId}. 현재 확인되지 않았으며 다른 음성으로 자동 변경하지 않았습니다.
+        </p>
+      )}
+      {selectedEntry && <p className="text-xs text-slate-600" role="status">선택됨: {optionLabel(selectedEntry)}</p>}
+    </section>
+  );
+}
