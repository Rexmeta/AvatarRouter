diff --git a/client/src/components/chat/useAvatarCleanup.ts b/client/src/components/chat/useAvatarCleanup.ts
new file mode 100644
index 0000000..53c75a0
--- /dev/null
+++ b/client/src/components/chat/useAvatarCleanup.ts
@@ -0,0 +1,50 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import { apiRequest } from "@/lib/queryClient";
+import { refreshCleanupSafely, type CleanupResult } from "@/lib/avatarCleanupCompat";
+
+/** The ended screen has no media client. Always use the existing authenticated BFF GET. */
+export function useAvatarCleanup(scope: string, endpoint: string, sessionId?: string) {
+  const [result, setResult] = useState<CleanupResult>({ state: "unknown" });
+  const [checking, setChecking] = useState(false);
+  const generation = useRef(0);
+  const busy = useRef(false);
+  const current = useRef({ scope, endpoint, sessionId });
+  current.current = { scope, endpoint, sessionId };
+
+  useEffect(() => {
+    generation.current++;
+    busy.current = false;
+    setChecking(false);
+    setResult({ state: "unknown" });
+    return () => { generation.current++; };
+  }, [scope, endpoint, sessionId]);
+
+  const invalidate = useCallback(() => {
+    generation.current++;
+    busy.current = false;
+    setChecking(false);
+    setResult({ state: "pending" });
+  }, []);
+
+  const refresh = useCallback(async () => {
+    if (busy.current) return;
+    busy.current = true;
+    setChecking(true);
+    const revision = generation.current;
+    const captured = current.current;
+    const isCurrent = () => revision === generation.current &&
+      captured.scope === current.current.scope && captured.endpoint === current.current.endpoint &&
+      captured.sessionId === current.current.sessionId;
+    // Do not remount/reload the SDK, reissue a descriptor or create a session to check cleanup.
+    const next = await refreshCleanupSafely(null, captured.sessionId, async () => {
+      const response = await apiRequest("GET", captured.endpoint);
+      return response.json();
+    });
+    if (!isCurrent()) return;
+    setResult(next);
+    busy.current = false;
+    setChecking(false);
+  }, []);
+
+  return { result, checking, refresh, invalidate };
+}
diff --git a/client/src/lib/avatarCleanupCompat.ts b/client/src/lib/avatarCleanupCompat.ts
new file mode 100644
index 0000000..11c1f51
--- /dev/null
+++ b/client/src/lib/avatarCleanupCompat.ts
@@ -0,0 +1,43 @@
+export type CleanupResult = {
+  state: "unknown" | "pending" | "confirmed";
+  code?: string;
+};
+export type CleanupClient = { sessionId?: string; refreshCleanup?: () => Promise<unknown> };
+
+/** Copy of AvatarRouter's bounded compatibility contract. Reads never issue media credentials. */
+export async function refreshCleanupSafely(
+  client: CleanupClient | null | undefined,
+  sessionId: string | undefined,
+  getSessionStatus?: (sessionId: string) => Promise<unknown>,
+): Promise<CleanupResult> {
+  const unknown = (code: string): CleanupResult => ({ state: "unknown", code });
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const bounded = (operation: () => Promise<unknown>) => Promise.race([
+    Promise.resolve().then(operation),
+    new Promise<never>((_, reject) => {
+      timer = setTimeout(() => reject(new Error("STATUS_TIMEOUT")), 8000);
+    }),
+  ]);
+  try {
+    if (typeof sessionId !== "string" || !sessionId) return unknown("ROUTER_STATUS_INVALID");
+    if (typeof client?.refreshCleanup === "function") {
+      if (client.sessionId !== sessionId) return unknown("ROUTER_STATUS_INVALID");
+      const state = await bounded(() => client.refreshCleanup!());
+      return state === "unknown" || state === "pending" || state === "confirmed"
+        ? { state } : unknown("ROUTER_STATUS_INVALID");
+    }
+    if (typeof getSessionStatus !== "function") return unknown("CLIENT_SDK_UPDATE_REQUIRED");
+    const status = await bounded(() => getSessionStatus(sessionId)) as {
+      id?: unknown; cleanupPending?: unknown; rendererState?: unknown;
+    } | null;
+    if (!status || status.id !== sessionId || typeof status.cleanupPending !== "boolean" ||
+        !(status.rendererState === null || typeof status.rendererState === "string")) {
+      return unknown("ROUTER_STATUS_INVALID");
+    }
+    return { state: status.rendererState === "closed" && status.cleanupPending === false ? "confirmed" : "pending" };
+  } catch {
+    return unknown("ROUTER_STATUS_UNCONFIRMED");
+  } finally {
+    clearTimeout(timer);
+  }
+}
