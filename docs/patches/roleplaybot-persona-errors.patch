+import { personaAvatarFailureSchema, type PersonaAvatarFailureReason, type PersonaAvatarStage } from "@shared/avatar/personaAvatarFailure";
+
+const stages: Record<PersonaAvatarStage, string> = {
+  catalog: "아바타 목록 조회", stock_faces: "기본 얼굴 조회", custom_faces: "맞춤 얼굴 조회",
+  voice_catalog: "음성 목록 조회", thumbnail: "얼굴 미리보기 조회", persona_input: "페르소나 설정 확인",
+  project_check: "프로젝트 권한 확인", seed: "시드 준비", seed_image: "시드 이미지 처리",
+  seed_options: "시드 후보 조회", creation: "맞춤 아바타 생성",
+  test: "아바타 테스트", test_preflight: "테스트 사전 확인", test_sessions: "테스트 세션 목록 조회",
+  test_start: "테스트 연결 요청", test_status: "테스트 세션 상태 조회", test_connection: "테스트 연결 정보 조회",
+  test_end: "테스트 종료 요청",
+};
+const reasons: Record<PersonaAvatarFailureReason, string> = {
+  invalid_input: "입력값이 올바르지 않습니다. 선택 내용을 확인하세요.",
+  invalid_request: "라우터가 요청을 거부했습니다. 선택 내용과 연결된 라우터의 버전을 확인하세요.",
+  invalid_response: "라우터 응답의 형식이나 크기가 맞지 않습니다. 연결 상태를 확인하세요.",
+  connection_failed: "라우터 응답을 받지 못했습니다. 연결 상태를 확인하세요.",
+  connection_unconfigured: "관리자가 AvatarRouter 연결 설정을 확인해야 합니다.",
+  authentication_failed: "라우터 인증이 거부되었습니다. 관리자가 프로젝트 연결을 확인해야 합니다.",
+  permission_denied: "라우터 권한이 부족합니다. 관리자가 프로젝트 권한을 확인해야 합니다.",
+  not_found: "요청한 항목 또는 기능을 현재 라우터에서 찾지 못했습니다.",
+  conflict: "현재 상태에서는 요청할 수 없습니다. 최신 상태를 다시 확인하세요.",
+  rate_limited: "요청이 너무 많습니다. 잠시 후 상태를 다시 확인하세요.",
+  unavailable: "라우터가 일시적으로 응답하지 않습니다. 잠시 후 상태를 다시 확인하세요.",
+  stock_catalog_unavailable: "기본 얼굴 목록을 확인할 수 없습니다. 잠시 후 다시 조회하세요.",
+  voice_catalog_unavailable: "음성 목록을 확인할 수 없습니다. 잠시 후 다시 조회하세요.",
+  voice_selection_invalid: "선택한 음성을 사용할 수 없거나 성별 분류가 변경되었습니다. 음성 목록을 다시 확인하세요.",
+  face_selection_invalid: "선택한 얼굴을 찾지 못했거나 현재 사용할 수 없습니다. 얼굴 목록을 다시 확인하세요.",
+  test_input_invalid: "테스트 요청이 유효하지 않습니다. 선택한 아바타와 연결 모드를 확인하세요.",
+  selection_project_mismatch: "선택한 아바타가 현재 프로젝트와 일치하지 않습니다. 목록에서 다시 선택하세요.",
+  outcome_uncertain: "요청 결과를 확인하지 못했습니다. 다시 제출하기 전에 상태를 조회하세요.",
+  unknown: "요청을 완료하지 못했습니다. 상태를 다시 확인하세요.",
+};
+
+// apiRequest prefixes a rejected response with its HTTP status. Never render its message/body.
+function unpack(cause: unknown): { status?: number; code?: string; failure?: unknown } {
+  if (!(cause instanceof Error)) return {};
+  const [prefix, status] = cause.message.match(/^(\d{3}):\s*/) ?? [];
+  if (!prefix) return {};
+  const body = cause.message.slice(prefix.length);
+  if (body.length > 16_384) return { status: Number(status) };
+  try {
+    const parsed = JSON.parse(body);
+    return { status: Number(status), code: typeof parsed?.code === "string" ? parsed.code : undefined, failure: parsed?.failure };
+  } catch {
+    return { status: Number(status), code: /^[a-z_0-9]{1,100}$/.test(body) ? body : undefined };
+  }
+}
+
+export function legacyPersonaAvatarErrorCode(cause: unknown): string {
+  return unpack(cause).code ?? "";
+}
+
+export function personaAvatarFailureText(cause: unknown, fallbackStage: PersonaAvatarStage): string;
+export function personaAvatarFailureText(cause: unknown): string | null;
+export function personaAvatarFailureText(cause: unknown, fallbackStage?: PersonaAvatarStage): string | null {
+  const { status, code, failure } = unpack(cause);
+  const checked = personaAvatarFailureSchema.safeParse(failure);
+  if (checked.success) {
+    const { stage, reason } = checked.data;
+    const detail = code === "avatar_assets_read_scope_missing" && reason === "permission_denied"
+      ? "얼굴과 음성 조회에 프로젝트의 assets:read 권한이 필요합니다."
+      : reasons[reason];
+    return `${stages[stage]} 실패: ${detail}`;
+  }
+  if (code === "avatar_assets_read_scope_missing") {
+    return `${stages.project_check} 실패: 얼굴과 음성 조회에 프로젝트의 assets:read 권한이 필요합니다.`;
+  }
+  if (code === "persona_voice_catalog_unavailable") {
+    return `${stages.voice_catalog} 실패: ${reasons.voice_catalog_unavailable}`;
+  }
+  if (!fallbackStage) return null;
+  const reason = cause instanceof Error && (cause.name === "ZodError" || cause.name === "SyntaxError") ? "invalid_response"
+    : status === 400 ? "invalid_request"
+    : status === 401 ? "authentication_failed"
+    : status === 403 ? "permission_denied"
+    : status === 404 ? "not_found"
+    : status === 409 ? "conflict"
+    : status === 429 ? "rate_limited"
+    : status !== undefined && status >= 500 ? "unavailable"
+    : cause instanceof TypeError ? "connection_failed" : "unknown";
+  return `${stages[fallbackStage]} 실패: ${reasons[reason]}`;
+}
