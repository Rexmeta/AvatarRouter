+import { personaAvatarFailureSchema, type PersonaAvatarFailureReason, type PersonaAvatarStage } from "../../../shared/avatar/personaAvatarFailure";
+import { AvatarIdentityError } from "./delegatedIdentity";
+
+// Accept only exact public AvatarRouter codes and their expected status. Never copy its text.
+const routerReasons = new Map<string, readonly [number, PersonaAvatarFailureReason]>([
+  ["STOCK_CATALOG_UNAVAILABLE", [503, "stock_catalog_unavailable"]],
+  ["VOICE_CATALOG_UNAVAILABLE", [503, "voice_catalog_unavailable"]],
+  ["VOICE_NOT_AVAILABLE", [409, "voice_selection_invalid"]],
+  ["VOICE_GENDER_CHANGED", [409, "voice_selection_invalid"]],
+  ["INVALID_VOICE_SELECTION", [400, "voice_selection_invalid"]],
+  ["STOCK_AVATAR_UNAVAILABLE", [409, "face_selection_invalid"]],
+  ["AVATAR_ASSET_NOT_FOUND", [404, "face_selection_invalid"]],
+  ["AVATAR_ASSET_NOT_READY", [409, "face_selection_invalid"]],
+  ["AVATAR_ASSET_MISMATCH", [400, "face_selection_invalid"]],
+  ["INVALID_SESSION_INPUT", [400, "test_input_invalid"]],
+  ["INVALID_PIPELINE_CONFIG", [400, "test_input_invalid"]],
+  ["INVALID_ANAM_CONFIG", [400, "test_input_invalid"]],
+  ["INVALID_ROLEPLAY_PIPELINE", [400, "test_input_invalid"]],
+  ["INVALID_ROLEPLAY_CONTEXT", [400, "test_input_invalid"]],
+  ["ROLEPLAY_CONTEXT_REQUIRED", [400, "test_input_invalid"]],
+  ["LIVE_COST_CONFIRMATION_REQUIRED", [400, "test_input_invalid"]],
+]);
+
+export function avatarFailureReason(status: number): PersonaAvatarFailureReason {
+  switch (status) {
+    case 400: case 413: case 415: case 422: return "invalid_request";
+    case 401: return "authentication_failed";
+    case 403: return "permission_denied";
+    case 404: return "not_found";
+    case 409: return "conflict";
+    case 429: return "rate_limited";
+    default: return status >= 500 ? "unavailable" : "unknown";
+  }
+}
+
+export function routerFailureReason(status: number, body: unknown): PersonaAvatarFailureReason {
+  const code = body && typeof body === "object" && "code" in body ? body.code : undefined;
+  const approved = typeof code === "string" ? routerReasons.get(code) : undefined;
+  return approved?.[0] === status ? approved[1] : avatarFailureReason(status);
+}
+
+const localFailures = new Map<string, readonly [PersonaAvatarStage | null, PersonaAvatarFailureReason]>([
+  ["avatar_assets_read_scope_missing", ["project_check", "permission_denied"]],
+  ["avatar_connection_unconfigured", [null, "connection_unconfigured"]],
+  ["avatar_connection_invalid", [null, "connection_unconfigured"]],
+  ["avatar_connection_rejected", [null, "authentication_failed"]],
+  ["avatar_connection_forbidden", [null, "permission_denied"]],
+  ["avatar_connection_rate_limited", [null, "rate_limited"]],
+  ["avatar_connection_check_failed", [null, "connection_failed"]],
+  ["avatar_connection_timeout", [null, "connection_failed"]],
+  ["persona_voice_unavailable", ["voice_catalog", "voice_selection_invalid"]],
+  ["persona_voice_catalog_unavailable", ["voice_catalog", "voice_catalog_unavailable"]],
+  ["persona_voice_offset_invalid", ["voice_catalog", "invalid_input"]],
+  ["persona_avatar_mode_invalid", ["persona_input", "invalid_input"]],
+  ["persona_live_avatar_invalid", ["persona_input", "invalid_input"]],
+  ["persona_avatar_asset_id_invalid", [null, "invalid_input"]],
+  ["persona_stock_avatar_unavailable", ["stock_faces", "face_selection_invalid"]],
+  ["persona_avatar_asset_not_ready", ["custom_faces", "face_selection_invalid"]],
+  ["persona_avatar_asset_mismatch", ["custom_faces", "face_selection_invalid"]],
+  ["persona_avatar_project_mismatch", ["persona_input", "selection_project_mismatch"]],
+  ["avatar_test_operation_uncertain", [null, "outcome_uncertain"]],
+  ["persona_seed_operation_uncertain", [null, "outcome_uncertain"]],
+  ["persona_avatar_creation_uncertain", [null, "outcome_uncertain"]],
+]);
+
+// Retain the existing machine codes used by the editor. Unknown local errors also use the safe fallback.
+const legacyCodes = new Set([
+  "avatar_test_read_failed", "avatar_test_path_invalid",
+  "avatar_test_id_invalid", "avatar_test_creation_in_progress", "avatar_test_session_mismatch", "avatar_test_session_not_running",
+  "avatar_test_token_expired", "avatar_test_turn_in_progress", "avatar_test_turn_limit", "avatar_test_turn_cancelled",
+  "avatar_test_pcm_invalid", "avatar_test_audio_rejected", "avatar_test_ai_unconfigured", "avatar_test_ai_failed",
+  "avatar_test_transcript_invalid", "avatar_managed_connection_post_required", "avatar_managed_connection_unavailable",
+  "avatar_client_connection_invalid", "anam_owns_dialogue_and_audio",
+  "avatar_identity_account_inactive", "avatar_identity_membership_invalid", "avatar_identity_not_verified",
+  "avatar_connection_upstream_unavailable",
+  "persona_avatar_thumbnail_not_available", "persona_avatar_asset_scopes_required", "persona_avatar_custom_runtime_unavailable",
+  "persona_avatar_contract_upgrade_required", "persona_avatar_creation_input_invalid", "persona_avatar_creation_in_progress",
+  "persona_avatar_image_invalid", "persona_avatar_pending_image_mismatch", "persona_avatar_provision_mismatch",
+  "persona_avatar_session_revision_mismatch", "persona_avatar_validation_capacity",
+  "persona_seed_busy", "persona_seed_candidate_mismatch", "persona_seed_consent_required", "persona_seed_contract_upgrade_required",
+  "persona_seed_cost_confirmation_required", "persona_seed_creation_blocked", "persona_seed_draft_invalid",
+  "persona_seed_draft_mismatch", "persona_seed_draft_required", "persona_seed_id_invalid", "persona_seed_image_invalid",
+  "persona_seed_image_stale", "persona_seed_image_unavailable", "persona_seed_persona_not_found", "persona_seed_register_first",
+  "persona_seed_reset_blocked", "persona_seed_reset_confirmation_required", "persona_seed_reset_stale", "persona_seed_save_image_first",
+  "persona_seed_source_unsupported", "persona_seed_upload_mismatch", "persona_seed_upload_avatar_test_operation_uncertain",
+  "persona_seed_upload_avatar_test_read_failed", "persona_seed_upload_avatar_test_path_invalid", "persona_seed_response_mismatch",
+]);
+export const avatarUpstreamStatuses = [400, 401, 403, 404, 409, 413, 415, 422, 429, 502, 503];
+for (const status of avatarUpstreamStatuses) {
+  legacyCodes.add(`avatar_test_upstream_${status}`);
+  legacyCodes.add(`persona_seed_upload_avatar_test_upstream_${status}`);
+}
+
+/** Shared by catalog, save and test routes; do not treat an upstream credential failure as local logout. */
+export function personaAvatarFailureResponse(error: unknown, stage: PersonaAvatarStage, fallbackCode: string) {
+  const local = error instanceof AvatarIdentityError ? error : undefined;
+  const mapped = local && localFailures.get(local.code);
+  const status = local?.status ?? 502;
+  const safe = personaAvatarFailureSchema.safeParse(local?.failure);
+  const failure = safe.success ? safe.data : {
+    stage: mapped?.[0] ?? stage,
+    reason: mapped?.[1] ?? (local ? avatarFailureReason(status) : "unknown" as const),
+  };
+  const code = local && (localFailures.has(local.code) || legacyCodes.has(local.code)) ? local.code : fallbackCode;
+  return { status: status === 401 ? 502 : status, body: { code, error: code, failure } };
+}
