{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "renderer": "node --enable-source-maps ./dist/renderer.mjs",
    "dev:renderer": "export NODE_ENV=development && pnpm run build && pnpm run renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.83",
    "@clerk/shared": "^4.41.1",
    "@google-cloud/storage": "^8.4.0",
    "@livekit/agents": "1.9.4",
    "@livekit/agents-plugin-tavus": "1.9.4",
    "@livekit/rtc-node": "1.2.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "http-proxy-middleware": "^4.2.1",
    "ipaddr.js": "^2.5.0",
    "livekit-server-sdk": "2.19.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0"
  }
}
